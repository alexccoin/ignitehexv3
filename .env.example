# IgniteHeX v3 — environment.
#
#   cp .env.example .env.local
#
# and fill in the two values for whichever backend you are pointing at. There is
# NO fallback: src/lib/supabase.ts throws at startup if either is missing, on
# purpose, so a local session can never silently end up reading production.
#
# THIS FILE IS COMMITTED. Every value below is a placeholder or a name. Never
# paste a real key here — .env.local is gitignored, this file is not.
#
# VITE_* variables are inlined into the JavaScript bundle at BUILD time, not
# read at runtime. They must be present wherever the build runs (Netlify's build
# environment, or `docker build --build-arg`), and changing one means rebuilding.
# See docs/DEPLOYMENT.md.

# ---------------------------------------------------------------------------
# Required — the frontend reads exactly these two.
# ---------------------------------------------------------------------------

# Option A — the self-hosted stack (c:/tmp/ignitehex-selfhost, `docker compose up`).
#   VITE_SUPABASE_URL             = http://localhost:${KONG_HTTP_PORT}   (55321)
#   VITE_SUPABASE_PUBLISHABLE_KEY = the value of ANON_KEY in that stack's .env
#
# Option B — the hosted project.
#   VITE_SUPABASE_URL             = https://<project-ref>.supabase.co
#   VITE_SUPABASE_PUBLISHABLE_KEY = the anon / publishable key from the
#                                   Supabase dashboard, Settings -> API
#
# The publishable key is meant to reach browsers and is not a secret. The
# service-role key is, and is never a VITE_ variable — anything prefixed VITE_
# is shipped to every visitor.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Local tooling only. Never read by frontend code, never built into a bundle,
# never needed by a deploy.
# ---------------------------------------------------------------------------

# Seed and admin scripts. Take it from SERVICE_ROLE_KEY in the self-hosted
# stack's .env. Pointing this at a hosted project would let a local script write
# to real member data with RLS bypassed — do not.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres, for the rebuild and seed scripts. Assemble it from the
# self-hosted stack's .env rather than copying a literal from anywhere:
#   postgresql://postgres:${POSTGRES_PASSWORD}@127.0.0.1:${POSTGRES_PORT}/postgres
# (Until 2026-08-19 this line carried that stack's real POSTGRES_PASSWORD as a
# literal, in this committed file. See docs/FINDINGS.md F-042.)
LOCAL_DATABASE_URL=
